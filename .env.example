# --- required ---
DISCORD_TOKEN=paste-your-bot-token-here
ALERT_CHANNEL_ID=123456789012345678      # channel where alerts post (right-click channel -> Copy ID)

# --- strongly recommended ---
BESTBUY_API_KEY=                          # free key from https://developer.bestbuy.com (Best Buy is off without it)
CONFIG_CHANNEL_ID=                        # a private channel for the bot's tracker backups (needed on Render free)
POKEMON_CHANNEL_ID=                       # everything Pokémon goes here (setup_discord.py or /setup fills these in)
YUGIOH_CHANNEL_ID=                        # everything Yu-Gi-Oh! goes here
NEWS_CHANNEL_ID=                          # fallback for news when the game channels aren't set
GUILD_ID=                                 # your server ID -> slash commands show up instantly instead of ~1 hour

# --- tuning (optional) ---
SCAN_INTERVAL_MIN=10                      # minutes between scans (don't go below 5)
REALERT_HOURS=6                           # don't re-ping the same item/store within this many hours
MAX_TARGET_STORES=20                      # cap on Target stores checked per scan
DIGEST_HOUR=9                             # local hour for the daily "coming up" drops post
TZ_NAME=America/Denver                    # your time zone (IANA name)
TARGET_KEY=                               # only if Target rotates its web key (see README)
EXCLUDE_WORDS=                            # extra words to ignore in product titles, comma separated
DATA_DIR=data
PORT=8080
